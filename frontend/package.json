{
  "name": "academic-info-system-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsc --noEmit --pretty && vite --port 5175 --host",
    "dev:full": "npm run generate-types && npm run dev",
    "build": "tsc --noEmit && vite build",
    "build-only": "vite build",
    "type-check": "",
    "preview": "vite preview",
    "generate-api": "openapi-ts",
    "generate-permissions": "node scripts/gen-permissions.mjs",
    "generate-types": "npm run generate-api && npm run generate-permissions",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.95.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.15",
    "babel-plugin-react-compiler": "^1.0.0",
    "d3": "^7.9.0",
    "d3-selection": "3.0.0",
    "d3-transition": "^3.0.1",
    "docx-preview": "^0.3.7",
    "driver.js": "^1.6.0",
    "husky": "^9.1.7",
    "jszip": "^3.10.1",
    "postcss": "^8.5.6",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^6.0.2",
    "vite": "^5.4.0",
    "zustand": "^5.0.12"
  }
}
